# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับระบบจริง
# รหัสผ่านจริงไม่ควรอยู่ใน git

# MySQL ชุดเดิม (ของระบบ PHP) — ใช้ user ที่มีสิทธิ์อ่านก่อน
DATABASE_URL="mysql://user:password@127.0.0.1:3306/lcb_office"

# คีย์เซ็น session cookie — สร้างด้วย: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-string"

# LINE Messaging API (สำหรับโมดูล Rich Menu) — เก็บฝั่งเซิร์ฟเวอร์เท่านั้น
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# ใช้กันคนนอกยิง endpoint cron
CRON_SECRET=""
